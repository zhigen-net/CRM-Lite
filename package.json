{
  "name": "crm-root",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:workers": "pnpm --filter workers dev",
    "build:web": "pnpm --filter web build",
    "cf:deploy": "bash scripts/cf-deploy.sh",
    "db:migrate:local": "pnpm --filter workers db:migrate:local",
    "typecheck": "pnpm -r typecheck"
  }
}
